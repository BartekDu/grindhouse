[Unit]
Description=Append one Claude quota sample to ~/.claude/quota_log.csv

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.claude/skills/quota/log_quota.py
# claude_usage.py drives the claude TUI on a pty; give it a sane env.
# The claude CLI lives in ~/.local/bin, which systemd user units don't get by default.
Environment=TERM=xterm-256color
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=180
