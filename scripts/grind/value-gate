#!/usr/bin/env bash
# value-gate — before a tier-(b)/(c) self-generated task, require it to name an
# OBJECTIVE win, so /grind cannot burn the window on "safe-looking" busywork that
# only creates review burden. Model-judged "is this valuable?" is itself
# rationalizable, so the bar is a measurable token, not vibes:
#
#   - a closed work-item id:  #123 / GH-123 / ISSUE-123 / PR #N / Jira-style ABC-123
#                             / TODO-x / T-NN (state.json tasks)
#                             / CF-NNN, TC-N, DD-NNN, RULE-NNN (semi-grind register ids)
#   - a coverage increase:    the word "coverage" + a +N or %% delta
#   - fewer lint/type errors: "lint"/"type"/mypy/eslint/ruff/clippy + a -N delta
#   - more tests:             "test(s)" + a +N delta
#   - project-specific extra: GRIND_VALUE_EXTRA_RE from .claude/grind/project.conf
#
# Usage: value-gate "<justification string>"
#   exit 0 if the justification names an objective win; non-zero (rejected) otherwise.
# The loop must then ACTUALLY deliver it; the claim is recorded to the audit log
# so the founder can verify post-hoc.
set -o pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"; cd "$ROOT" || exit 1
. "$HERE/config.sh"; . "$HERE/lib.sh"

just="${1:-}"
[ -n "$just" ] || grind_die 'usage: value-gate "<justification naming an objective win>"'

# objective-win patterns
# Work-item ids stay CASE-SENSITIVE (a case-insensitive [A-Z]+-[0-9]+ would
# false-pass on strings like "utf-8"); the delta patterns are case-insensitive.
if printf '%s' "$just" | grep -qE '(#[0-9]+|\b(GH|ISSUE|PR)[ -]?#?[0-9]+|\b[A-Z][A-Z0-9]+-[0-9]+\b|\bT-[0-9]+\b|\bTODO-[A-Za-z0-9_]+\b)' \
   || printf '%s' "$just" | grep -qiE 'coverage.*[+][0-9]|coverage.*[0-9]+%' \
   || printf '%s' "$just" | grep -qiE '(lint|type|mypy|eslint|ruff|clippy).*(-[0-9]+|fewer|down|0 errors)' \
   || printf '%s' "$just" | grep -qiE 'tests?[^-]*[+][0-9]' \
   || { [ -n "${GRIND_VALUE_EXTRA_RE:-}" ] && printf '%s' "$just" | grep -qE "$GRIND_VALUE_EXTRA_RE"; }; then
  grind_audit "value_gate" "PASS claim=$just"
  echo "PASS"; exit 0
fi

echo "!!! GRIND VALUE-GATE: rejected — no objective win named." >&2
echo "Justification was: $just" >&2
echo "Name a closed work-item id (#N / TODO-x / ABC-123 / CF-NNN), a coverage/test increase, or a lint/type-error decrease — or skip this task and log it." >&2
grind_audit "value_gate" "REJECT claim=$just"
echo "REJECT"; exit 1
