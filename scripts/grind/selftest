# ---------- N+1. the contribution law: anon-guard ----------
# The licence obligation is to contribute back ANONYMIZED. Semantics under test:
# ADDED lines only — the engine's own history is full of client references, and
# a whole-tree scan would fail every PR forever.
AGD="$TMP/ag"; AGT="$TMP/anon-terms"
printf 'acme-?corp\n\\bWidgetCo\\b\n# a comment\n\n' > "$AGT"
ag_repo() {
  rm -rf "$AGD"; mkdir -p "$AGD" && cd "$AGD" || return 1
  git init -q -b main 2>/dev/null || { git init -q && git checkout -qb main; }
  git config user.email selftest@grindhouse && git config user.name selftest
  git config commit.gpgsign false
  echo "history: built for AcmeCorp on the WidgetCo account" > legacy.md
  git add -A && git commit -qm "init: legacy client references"
  git checkout -qb feat 2>/dev/null || git branch -q feat && git checkout -q feat
}
ag() { env GRIND_ANON_TERMS="$AGT" bash "$SRC/anon-guard" "$@"; }

ag_repo
echo "generalized: a large product repo hit the two-python trap" > new.md
git add -A && git commit -qm "feat: generalized finding"
