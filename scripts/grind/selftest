#!/usr/bin/env bash
# selftest — the law, proven. No network, no Claude auth, no quota spend:
# quota-gate is exercised through FIXTURE statusline readings (GRIND_QUOTA_READINGS
# + a pinned GRIND_NOW) and the PAUSE/STOP sentinels, never a live reading.
#
# Runs the WHOLE guardrail matrix in throwaway git repos under mktemp, with the
# checkout-under-test VENDORED into the temp repo (repo-local scripts/grind wins
# in grind-bootstrap, so the hooks exercise THIS checkout's code, not whatever
# is installed in ~/.claude). Safe to run anywhere, including CI (ubuntu +
# windows git-bash).
#
# Usage:  bash scripts/grind/selftest        exit 0 = all green, 1 = failures
set -o pipefail
SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYBIN="$(command -v python3 || command -v python)"

PASS=0; FAIL=0
ok()   { PASS=$((PASS+1)); echo "  ok  - $1"; }
bad()  { FAIL=$((FAIL+1)); echo "  FAIL- $1"; }
# expect_rc NAME WANT_RC CMD...
expect_rc() {
  local name="$1" want="$2"; shift 2
  "$@" >/dev/null 2>&1; local got=$?
  [ "$got" = "$want" ] && ok "$name (rc=$got)" || bad "$name (want rc=$want got rc=$got)"
}

TMP="$(mktemp -d)"
trap 'cd /; rm -rf "$TMP"' EXIT

new_repo() {  # new_repo DIR  -> fresh main-branch repo with the law vendored in
  local d="$1"
  mkdir -p "$d" && cd "$d" || return 1
  git init -q -b main 2>/dev/null || { git init -q && git checkout -qb main; }
  git config user.email selftest@grindhouse && git config user.name selftest
  git config commit.gpgsign false
  mkdir -p src/api infra scripts/grind
  cp -f "$SRC"/* scripts/grind/ 2>/dev/null
  echo x > src/api/a.txt && echo y > infra/i.txt
  git add -A && git commit -qm "init: selftest seed"
}

echo "== selftest: $SRC (python: $PYBIN)"

# ---------- 1. bootstrap: arms all three hooks, resolves repo-local ----------
new_repo "$TMP/r1"
source scripts/grind/grind-bootstrap.sh >/dev/null 2>&1
[ "$GRIND_BOOTSTRAP_STATUS" = "OK" ] && ok "bootstrap OK status" || bad "bootstrap status=$GRIND_BOOTSTRAP_STATUS"
hooks_ok=1
for h in pre-commit pre-push commit-msg; do
  grep -q 'GRIND HOOK' "$(git rev-parse --git-path hooks)/$h" 2>/dev/null || hooks_ok=0
done
[ "$hooks_ok" = "1" ] && ok "3 hooks armed (pre-commit, pre-push, commit-msg)" || bad "hook(s) missing"
# path-spelling-agnostic compare: git-bash reports C:/-style toplevels while
# mktemp speaks /tmp-style, and /tmp is a MOUNT of C:/Users/<u>/AppData/Local/Temp
# — two spellings of one dir that no string canonicalization unifies. Anchor on
# mktemp's unique random dirname instead: identical in every spelling.
case "$G" in
  *"${TMP##*/}/r1/scripts/grind") ok "G resolves repo-local (vendored copy wins)";;
  *) bad "G=$G (want .../${TMP##*/}/r1/scripts/grind)";;
esac

# ---------- 2. bootstrap: foreign hook -> conflict, non-zero ----------
new_repo "$TMP/r2"
printf '#!/bin/sh\necho mine\n' > .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
source scripts/grind/grind-bootstrap.sh >/dev/null 2>&1
rc=$?
{ [ "$rc" != "0" ] && [ "${GRIND_BOOTSTRAP_STATUS#HOOK_CONFLICT}" != "$GRIND_BOOTSTRAP_STATUS" ]; } \
  && ok "foreign hook -> HOOK_CONFLICT rc=$rc" || bad "foreign hook: rc=$rc status=$GRIND_BOOTSTRAP_STATUS"
grep -q 'echo mine' .git/hooks/pre-commit && ok "foreign hook NOT clobbered" || bad "foreign hook clobbered"
# all-or-nothing: the conflict must abort the WHOLE install, not arm the other two
{ [ ! -e .git/hooks/pre-push ] && [ ! -e .git/hooks/commit-msg ]; } \
  && ok "conflict installs NOTHING (all-or-nothing)" || bad "conflict left a partial install"

# ---------- 2b. bootstrap: legacy v1 hook upgraded in place ----------
new_repo "$TMP/r2b"
printf '#!/usr/bin/env bash\n# !!! GRIND HOOK !!!  (installed by grind-bootstrap.sh; safe to delete to disarm)\nexec bash "/old/absolute/path/scope-guard" "$@"\n' > .git/hooks/pre-commit
chmod +x .git/hooks/pre-commit
source scripts/grind/grind-bootstrap.sh >/dev/null 2>&1
[ "$GRIND_BOOTSTRAP_STATUS" = "OK" ] && grep -q 'GRIND HOOK v2' .git/hooks/pre-commit \
  && ok "legacy v1 hook upgraded to v2 in place" || bad "v1->v2 upgrade failed (status=$GRIND_BOOTSTRAP_STATUS)"

# ---------- 2c. hook wrapper: missing bundle -> fail-open, fail-closed in window ----------
mkdir -p "$TMP/r2c" && cd "$TMP/r2c"
git init -q -b main 2>/dev/null || { git init -q && git checkout -qb main; }
git config user.email selftest@grindhouse && git config user.name selftest
echo x > f && git add f && git commit -qm "init: seed"
source "$SRC/grind-bootstrap.sh" >/dev/null 2>&1   # global-bundle path; repo has NO vendored copy
HOME=/nonexistent-home bash .git/hooks/commit-msg /dev/null >/dev/null 2>&1
[ $? = 0 ] && ok "missing bundle outside a window: fail-open (warn+skip)" || bad "missing bundle outside a window blocked the commit"
mkdir -p .claude/grind && touch .claude/grind/.active
HOME=/nonexistent-home bash .git/hooks/commit-msg /dev/null >/dev/null 2>&1
[ $? = 1 ] && ok "missing bundle in an ACTIVE window: fail-closed" || bad "missing bundle in a window did NOT fail closed"
rm -rf .claude/grind

# ---------- 3. hygiene + lock (r1 from here on) ----------
cd "$TMP/r1"; G="$TMP/r1/scripts/grind"
GJ() { "$PYBIN" "$G/grindjson.py" "$@"; }
bash "$G/hygiene-check" fix >/dev/null
git add .gitignore && git commit -qm "chore: gitignore scratch noise"
expect_rc "hygiene verify clean after fix+commit" 0 bash "$G/hygiene-check" verify
# grind's own untracked bookkeeping must not block acquire
mkdir -p .claude/grind && echo '{}' > .claude/grind/state.json
expect_rc "lock acquire (grind bookkeeping untracked is exempt)" 0 bash "$G/lock.sh" acquire w1
# the holder pid is a one-shot process; the single-run contract is age+release,
# so a second acquire while the lock is FRESH must refuse (no pid-based steal)
expect_rc "second acquire refused while held" 1 bash "$G/lock.sh" acquire w2

# focus contract for the guard tests
GJ set .claude/grind/state.json focus '{"label":"api","allowed_globs":["src/api/**"],"forbidden_globs":["infra/**"]}'

# ---------- 4. quota-gate: every exit code from fixture statusline readings ----------
NOW=1800000000; R="$TMP/readings.jsonl"
export GRIND_QUOTA_PROBE=""     # the probe is OFF unless a test turns it on (never the real ~/.claude/tools one)
# rd FH_USED WK_USED [AGE_S] [EXTRA_JSON_FIELDS] -> one reading line (contract: cc-ledger docs/READINGS.md)
rd() {
  printf '{"ts": "x", "t": %s, "five_hour_used": %s, "five_hour_resets_at": %s, "week_used": %s, "week_resets_at": %s, "session": "selftest", "source": "statusline"%s}\n' \
    "$((NOW - ${3:-60})).5" "$1" "$((NOW + 3600))" "$2" "$((NOW + 86400))" "${4:+, $4}"
}
QG() { GRIND_NOW=$NOW GRIND_QUOTA_READINGS="$R" bash "$G/quota-gate.sh" "$@"; }
rd 45 20 > "$R"
expect_rc "quota-gate GO"                            0 QG
out="$(QG)"; case "$out" in "GO five_hour_left=55 week_left=80 week_model_left=-1 src=statusline age=59s") ok "gate line: 100-used, WM=-1 when absent, age";; *) bad "gate line: '$out'";; esac
expect_rc "quota-gate --force is a no-op (still GO)" 0 QG --force
fh="$(GJ get .claude/grind/.quota-cache.json five_hour_pct_left)"
[ "$fh" = "55" ] && ok "gate keeps .quota-cache.json for grind-office" || bad "cache not written (got '$fh')"
rd 92 20 > "$R";  expect_rc "quota-gate STOP_FLOOR"                2 QG
rd 45 95 > "$R";  expect_rc "quota-gate STOP_WEEKLY (all-models)"  3 QG
rd 45 100 > "$R"; expect_rc "quota-gate STOP_WEEKLY (week=0)"      3 QG
rd 45 20 60 '"week_model_used": 95' > "$R"; expect_rc "quota-gate STOP_WEEKLY (per-model)"  3 QG
rd 45 20 60 '"week_model_used": 5' > "$R";  expect_rc "quota-gate GO (per-model 95% left)"  0 QG
rd 87.5 20 > "$R"; expect_rc "quota-gate NO_NEW_TASK (reserve, float used)" 4 QG
rd 45 20 > "$R"
touch .claude/grind/STOP;  expect_rc "quota-gate STOP_KILL"   5 QG; rm .claude/grind/STOP
touch .claude/grind/PAUSE; expect_rc "quota-gate SOFT_PAUSE"  7 QG; rm .claude/grind/PAUSE
rd 45 20 1000 > "$R"; expect_rc "quota-gate POLL_FAILED (stale reading)" 6 QG
rd 45 20 | sed "s/\"five_hour_resets_at\": [0-9]*/\"five_hour_resets_at\": $((NOW - 10))/" > "$R"
expect_rc "quota-gate POLL_FAILED (reading predates 5h reset)" 6 QG
rd 45 20 | sed 's/"five_hour_resets_at": [0-9]*/"five_hour_resets_at": null/' > "$R"
expect_rc "quota-gate GO (five_hour_resets_at null)" 0 QG
expect_rc "quota-gate POLL_FAILED (no readings file)" 6 env GRIND_NOW=$NOW GRIND_QUOTA_READINGS="$TMP/none.jsonl" bash "$G/quota-gate.sh"
{ rd 45 20; printf '{"t": %s, "five_hour_us' "$NOW"; } > "$R"
expect_rc "quota-gate GO (truncated last line skipped)" 0 QG
{ rd 92 20 30; rd 45 20 300; } > "$R"
expect_rc "quota-gate interleaved lines: max t wins (STOP_FLOOR)" 2 QG
rd 45 20 > "$R"
expect_rc "quota-gate STOP_WEEKLY (GRIND_HARD_STOP_AT passed)" 3 env GRIND_HARD_STOP_AT=$((NOW - 1)) GRIND_NOW=$NOW GRIND_QUOTA_READINGS="$R" bash "$G/quota-gate.sh"
expect_rc "quota-gate GO (GRIND_HARD_STOP_AT ahead)" 0 env GRIND_HARD_STOP_AT=$((NOW + 600)) GRIND_NOW=$NOW GRIND_QUOTA_READINGS="$R" bash "$G/quota-gate.sh"
GJ set .claude/grind/state.json run_opts "{\"hard_stop_at\": \"$((NOW - 1))\"}"
expect_rc "quota-gate STOP_WEEKLY (run_opts.hard_stop_at from --until)" 3 QG
GJ set .claude/grind/state.json run_opts '{}'
rd 45 20 | sed "s/\"week_resets_at\": [0-9]*/\"week_resets_at\": $((NOW + 200))/" > "$R"
expect_rc "quota-gate STOP_WEEKLY (STOP_BEFORE_WEEK_RESET_MIN=5)" 3 env GRIND_STOP_BEFORE_WEEK_RESET_MIN=5 GRIND_NOW=$NOW GRIND_QUOTA_READINGS="$R" bash "$G/quota-gate.sh"
expect_rc "quota-gate GO (week reset far, MIN=5)" 0 env GRIND_STOP_BEFORE_WEEK_RESET_MIN=1 GRIND_NOW=$NOW GRIND_QUOTA_READINGS="$R" bash "$G/quota-gate.sh"
rd 45 20 > "$R"
expect_rc "quota-gate --next-window CHAIN"            0 QG --next-window
expect_rc "quota-gate --next-window NO_CHAIN (until)" 3 env GRIND_HARD_STOP_AT=$((NOW + 1800)) GRIND_NOW=$NOW GRIND_QUOTA_READINGS="$R" bash "$G/quota-gate.sh" --next-window
GJ set .claude/grind/state.json run_opts '{"chain": false}'
expect_rc "quota-gate --next-window NO_CHAIN (--no-chain)" 3 QG --next-window
GJ set .claude/grind/state.json run_opts '{}'
printf 'import json\nprint(json.dumps({"five_hour_pct_left": 55, "week_pct_left": 80, "week_model_pct_left": None}))\n' > "$TMP/tool.py"
expect_rc "quota-gate GO via GRIND_QUOTA_TOOL adapter" 0 env GRIND_QUOTA_TOOL="$TMP/tool.py" GRIND_QUOTA_READINGS="$TMP/none.jsonl" bash "$G/quota-gate.sh"
printf 'raise SystemExit(1)\n' > "$TMP/tool.py"
expect_rc "quota-gate POLL_FAILED via broken adapter" 6 env GRIND_QUOTA_TOOL="$TMP/tool.py" bash "$G/quota-gate.sh"
rd 45 20 > "$R"
expect_rc "quota-gate GRIND_READING_MAX_AGE_SEC from env makes a 59 s reading stale" 6 env GRIND_READING_MAX_AGE_SEC=30 GRIND_NOW=$NOW GRIND_QUOTA_READINGS="$R" bash "$G/quota-gate.sh"
# probe: stale / missing reading -> run GRIND_QUOTA_PROBE ONCE, re-read ONCE (fake probe; no network, no auth)
cat > "$TMP/fakeprobe.py" <<'PROBE_EOF'
import json, os, sys
a = sys.argv[1:]
d = os.environ["FAKE_PROBE_DIR"]
open(os.path.join(d, "calls"), "a").write("x\n")
if os.environ.get("FAKE_PROBE_FAIL"):
    sys.stderr.write("fake probe: token expired\n"); sys.exit(4)
now = int(os.environ["GRIND_NOW"])
path = a[a.index("--readings") + 1]
if "--write" in a:
    open(path, "a").write(json.dumps({"ts": "x", "t": now - 2.5, "five_hour_used": 30, "five_hour_resets_at": now + 7200, "week_used": 10,
        "week_resets_at": now + 86400, "week_model_used": 20, "week_model_name": "Fable", "session": "probe", "source": "oauth"}) + "\n")
PROBE_EOF
PD="$TMP/probe"; mkdir -p "$PD"
PG() { rm -f "$PD/calls"; GRIND_NOW=$NOW FAKE_PROBE_DIR="$PD" GRIND_QUOTA_READINGS="$R" GRIND_QUOTA_PROBE="$TMP/fakeprobe.py --write" "$@" bash "$G/quota-gate.sh"; }
calls() { [ -f "$PD/calls" ] && wc -l < "$PD/calls" | tr -d ' ' || echo 0; }
rd 45 20 1000 > "$R"
out="$(PG env)"; rc=$?
[ "$rc" = 0 ] && case "$out" in "GO five_hour_left=70 week_left=90 week_model_left=80 src=oauth age=2s") true;; *) false;; esac \
  && ok "probe: stale reading refreshed by the probe -> GO, src=oauth, per-model bar read ($out)" || bad "probe refresh: rc=$rc '$out'"
[ "$(calls)" = 1 ] && ok "probe ran exactly once" || bad "probe calls=$(calls)"
tail -n 40 .claude/grind/audit.log | grep -q 'quota_probe.*rc=0 fakeprobe.py' && ok "probe attempt audited (quota_probe rc=0)" || bad "no quota_probe audit line"
tail -n 40 .claude/grind/audit.log | grep -q 'five_hour_left=70% .* src=oauth' && ok "gate audit line keeps src from the record's source" || bad "audit src not oauth"
rm -f "$R"; PG env >/dev/null; rc=$?
[ "$rc" = 0 ] && ok "probe: missing readings file created by the probe -> GO" || bad "probe on missing file: rc=$rc"
rd 45 20 | sed "s/\"five_hour_resets_at\": [0-9]*/\"five_hour_resets_at\": $((NOW - 10))/" > "$R"
PG env >/dev/null; rc=$?
[ "$rc" = 0 ] && ok "probe: reading from before the 5h reset refreshed -> GO" || bad "probe after reset: rc=$rc"
rd 45 20 1000 > "$R"
out="$(PG env FAKE_PROBE_FAIL=1)"; rc=$?
[ "$rc" = 6 ] && ok "probe failure ignored: still POLL_FAILED (rc=6)" || bad "probe failure: rc=$rc '$out'"
[ "$(calls)" = 1 ] && ok "failed probe is not retried (one run)" || bad "failed probe calls=$(calls)"
tail -n 40 .claude/grind/audit.log | grep -q 'POLL_FAILED.*probe rc=4' && ok "POLL_FAILED audit names the probe result" || bad "POLL_FAILED audit lacks probe rc"
# per-model carry-over: the status line has no per-model bar; the newest fresh oauth value from the same week is used
rdo() { printf '{"ts": "x", "t": %s, "five_hour_used": 50, "five_hour_resets_at": %s, "week_used": 20, "week_resets_at": %s, "week_model_used": %s, "week_model_name": "Fable", "session": "probe", "source": "oauth"}\n' \
    "$((NOW - $2)).5" "$((NOW + 3600))" "$((NOW + 86400 + ${3:-1}))" "$1"; }
{ rdo 20 300; rd 45 20 60; } > "$R"
out="$(QG)"; case "$out" in "GO five_hour_left=55 week_left=80 week_model_left=80 src=statusline age=59s") ok "per-model bar carried from a fresh oauth reading of the same week";; *) bad "carry: '$out'";; esac
{ rdo 95 300; rd 45 20 60; } > "$R"; expect_rc "carried per-model bar 5% left -> STOP_WEEKLY" 3 QG
{ rdo 20 1000; rd 45 20 60; } > "$R"
out="$(QG)"; case "$out" in *"week_model_left=-1 "*) ok "stale oauth per-model value is not carried";; *) bad "stale carry: '$out'";; esac
{ rdo 20 300 -604800; rd 45 20 60; } > "$R"
out="$(QG)"; case "$out" in *"week_model_left=-1 "*) ok "per-model value from another week is not carried";; *) bad "other-week carry: '$out'";; esac
rd 45 20 60 > "$R"
out="$(PG env)"; rc=$?
[ "$rc" = 0 ] && [ "$(calls)" = 1 ] && case "$out" in *"week_model_left=80 "*) true;; *) false;; esac \
  && ok "fresh reading without per-model bar -> probe once, bar filled ($out)" || bad "probe for per-model: rc=$rc calls=$(calls) '$out'"
rd 45 20 60 '"week_model_used": 5' > "$R"; PG env >/dev/null
[ "$(calls)" = 0 ] && ok "fresh reading with a per-model bar: the probe is not run" || bad "probe ran on a fresh reading"
rd 45 20 1000 > "$R"; PG env GRIND_QUOTA_PROBE="" >/dev/null; rc=$?
[ "$rc" = 6 ] && [ "$(calls)" = 0 ] && ok "GRIND_QUOTA_PROBE empty: probe off, POLL_FAILED" || bad "probe off: rc=$rc calls=$(calls)"
PG env GRIND_QUOTA_PROBE="$TMP/no-such-probe.py --write" >/dev/null; rc=$?
[ "$rc" = 6 ] && ok "missing probe script ignored: POLL_FAILED" || bad "missing probe: rc=$rc"
u="$(GRIND_NOW=$NOW GJ resolve-until 23:59)"
[ -n "$u" ] && ok "resolve-until HH:MM -> absolute ISO ($u)" || bad "resolve-until failed"

# ---------- 4b. quick-start run options, project rules, wave brief ----------
expect_rc "run-opts set (--until --no-chain --max-concurrent)" 0 env GRIND_NOW=$NOW bash "$G/run-opts" set --until 23:59 --no-chain --max-concurrent 2
o="$(bash "$G/run-opts" show)"
case "$o" in "run_opts: until=20"*" chain=off max_concurrent=2") ok "run-opts show: stored + effective ($o)";; *) bad "run-opts show: '$o'";; esac
expect_rc "run-opts rejects unknown flag" 1 bash "$G/run-opts" set --bogus
expect_rc "run-opts rejects non-numeric --max-concurrent" 1 bash "$G/run-opts" set --max-concurrent x
rd 45 20 > "$R"
expect_rc "quota-gate --next-window honours stored --no-chain" 3 QG --next-window
GJ set .claude/grind/state.json run_opts '{}'
o="$(bash "$G/run-opts" show)"
case "$o" in *"chain=on max_concurrent=4") ok "run-opts defaults from config.sh";; *) bad "run-opts defaults: '$o'";; esac
rm -f .claude/grind/rules.md
o="$(bash "$G/rules-init" | tail -1)"
[ "$o" = "skeleton" ] && [ -f .claude/grind/rules.md ] && ok "rules-init creates the skeleton" || bad "rules-init: '$o'"
echo "- parts fit 240 mm" >> .claude/grind/rules.md
o="$(bash "$G/rules-init" | tail -1)"
[ "$o" = "rules: 1" ] && ok "rules-init keeps existing rules (never overwrites)" || bad "rules-init after edit: '$o'"
rm -f .claude/grind/rules.md
o="$(GRIND_BRIEF_TOOL="$TMP/none.py" bash "$G/wave-brief")"; rc=$?
case "$rc:$o" in "0:task deadline"*"skipped"*) ok "wave-brief advisory: deadline + skip without cc-brief (rc 0)";; *) bad "wave-brief: rc=$rc '$o'";; esac
d="$(GRIND_NOW=$NOW GJ deadline 10)"
[ "$d" = "2027-01-15T08:10:00Z" ] && ok "deadline: now + N min in UTC" || bad "deadline: '$d'"

# ---------- 5. scope-guard ----------
echo z >> src/api/a.txt && git add src/api/a.txt
git commit -qm "api: in-focus change" && ok "scope: in-focus commit passes" || bad "scope: in-focus commit blocked"
echo z >> infra/i.txt && git add infra/i.txt
git commit -qm "infra: sneak" >/dev/null 2>&1 && bad "scope: forbidden path NOT blocked" || ok "scope: forbidden path blocked"
git reset -q && git checkout -q infra/i.txt
echo '# extra' >> .gitignore && git add .gitignore
git commit -qm "chore: gitignore extra" >/dev/null 2>&1 && ok "scope: .gitignore allowed mid-window (hygiene can operate)" || bad "scope: .gitignore blocked mid-window"
# worktree law: a builder branch commit from the shared checkout is refused
git checkout -qb grind/feat/wt-law
echo w >> src/api/a.txt && git add src/api/a.txt
git commit -qm "api: from shared checkout" >/dev/null 2>&1 && bad "worktree law: shared-checkout commit NOT blocked" || ok "worktree law: builder branch outside worktree blocked"
git reset -q && git checkout -q . && git checkout -q main

# ---------- 5b. worktree ENFORCEMENT (state anchored at the main root) ----------
# The other half of the worktree law: once builders ARE in worktrees, the focus
# contract must still reach them (state.json/.active live at the main root).
git worktree add -q .claude/worktrees/grind-feat-wt grind/feat/wt-law
(
  cd .claude/worktrees/grind-feat-wt || exit 9
  echo sneak >> infra/i.txt && git add infra/i.txt
  git commit -qm "infra: sneak from worktree" >/dev/null 2>&1
) && bad "worktree: forbidden path NOT blocked inside a worktree" || ok "worktree: forbidden path blocked inside a worktree"
( cd .claude/worktrees/grind-feat-wt && git reset -q && git checkout -q infra/i.txt )
(
  cd .claude/worktrees/grind-feat-wt || exit 9
  echo m >> src/api/a.txt && git add src/api/a.txt
  git commit -qm "wip" >/dev/null 2>&1
) && bad "worktree: opaque message NOT blocked inside a worktree" || ok "worktree: opaque message blocked inside a worktree"
(
  cd .claude/worktrees/grind-feat-wt || exit 9
  git commit -qm "api: real work from worktree" >/dev/null 2>&1
) && ok "worktree: in-focus conventional commit passes" || bad "worktree: in-focus commit blocked"
# semi-grind contract: RULEBOOK.md + register dir in allowed_globs -> consolidator can commit
GJ set .claude/grind/state.json focus '{"label":"api+campaign","allowed_globs":["src/api/**","RULEBOOK.md","docs/consistency-x/**"],"forbidden_globs":["infra/**"]}'
(
  cd .claude/worktrees/grind-feat-wt || exit 9
  echo rules > RULEBOOK.md && git add RULEBOOK.md
  git commit -qm "docs: ratify RULE-001" >/dev/null 2>&1
) && ok "worktree: RULEBOOK.md passes with the semi-grind Step-0 contract" || bad "worktree: RULEBOOK.md blocked despite contract"
GJ set .claude/grind/state.json focus '{"label":"api","allowed_globs":["src/api/**"],"forbidden_globs":["infra/**"]}'
git worktree remove --force .claude/worktrees/grind-feat-wt 2>/dev/null

# ---------- 6. commit-msg-guard ----------
echo m >> src/api/a.txt && git add src/api/a.txt
git commit -qm "wip" >/dev/null 2>&1 && bad "msg: 'wip' NOT blocked" || ok "msg: 'wip' blocked"
git commit -qm "api: fixes" >/dev/null 2>&1 && bad "msg: opaque subject NOT blocked" || ok "msg: opaque subject blocked"
git commit -qm "api: add selftest marker" >/dev/null 2>&1 && ok "msg: conventional message passes" || bad "msg: conventional message blocked"

# ---------- 7. value-gate (generic + project extra) ----------
expect_rc "value: issue id (#12)"         0 bash "$G/value-gate" "closes #12"
expect_rc "value: Jira-style (SEC-12)"    0 bash "$G/value-gate" "closes SEC-12"
expect_rc "value: semi-grind id (CF-001)" 0 bash "$G/value-gate" "closes CF-001, lint -3"
expect_rc "value: coverage delta"         0 bash "$G/value-gate" "coverage +4%"
expect_rc "value: vibes rejected"         1 bash "$G/value-gate" "improves overall quality"
GRIND_VALUE_EXTRA_RE='\bE[0-9]+\b' bash "$G/value-gate" "closes E7" >/dev/null 2>&1 \
  && ok "value: GRIND_VALUE_EXTRA_RE honored" || bad "value: extra regex ignored"

# ---------- 8. verify-run ----------
printf 'true\n' > .claude/grind/verify-cmds
expect_rc "verify-run: explicit gate green" 0 bash "$G/verify-run"
printf 'false\n' > .claude/grind/verify-cmds
