#!/usr/bin/env bash
# landable-guard — pre-push hook. Two protections:
#   1. A deferred human-gate makes the branch NON-LANDABLE: if gate-ledger.md has
#      any OPEN blocking gate (an unchecked "- [ ]" line tagged needs:<anything>,
#      BLOCKS, or non-landable), the push is refused. /grind may keep doing other
#      in-focus work, but it can never push/ship a branch with unverified gates.
#      (Incident: the regex once matched only needs:/qa|/cso — semi-grind's
#      `needs:decision` gates pushed straight through the guard.)
#   2. Never push directly to a protected branch (GRIND_PROTECTED_BRANCHES from
#      config.sh / project.conf; default "dev main master"). WINDOW-ONLY: this
#      is grind policy for the autonomous loop, enforced only while .active
#      exists — it must not permanently hijack the founder's normal push
#      workflow (incident: one /grind run left the repo refusing every direct
#      push to main forever). Permanent "PRs only" belongs to remote branch
#      protection, not this hook. Override for a genuine emergency mid-window
#      with GRIND_ALLOW_PUSH=1 (prints why).
#
# Reads refs from stdin (git pre-push protocol: "<local_ref> <local_sha> <remote_ref> <remote_sha>").
set -o pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"; cd "$ROOT" || exit 0
. "$HERE/config.sh"; . "$HERE/lib.sh" 2>/dev/null || true

fail=0

# 1. open-gate block (only if a gate-ledger exists with unchecked blocking lines)
#    !!! FENCE-SKIP TRAP !!! The ledger documents its own row FORMAT inside a
#    ```text fence (e.g. "- [ ] G-01 | needs:/cso | ... <branch>"). A naive grep
#    matches that example and false-blocks EVERY push (the ledger ships on dev).
#    Strip fenced lines first so only REAL gate rows count. See PROGRESS.md
#    2026-05-30 landable-guard-fence fix.
if [ -f "$GRIND_GATELEDGER" ]; then
  open_gates="$(awk '/^[[:space:]]*```/{f=!f; next} !f' "$GRIND_GATELEDGER" 2>/dev/null \
    | grep -E '^- \[ \].*(needs:|BLOCKS|non-landable)' 2>/dev/null || true)"
  if [ -n "$open_gates" ]; then
    echo "!!! GRIND LANDABLE-GUARD: push blocked — open human-gates (branch is non-landable) !!!" >&2
    echo "$open_gates" | sed 's/^/  /' >&2
    echo "Clear them: run the gate (the named check) with the founder, then check the box in $GRIND_GATELEDGER." >&2
    fail=1
  fi
fi

# 2. no direct push to a protected branch (default: dev main master) — but ONLY
#    while a grind window is active; outside a window the founder's normal
#    pushes are none of grind's business. (Stdin must still be drained either way.)
window_active=0
command -v grind_active >/dev/null 2>&1 && grind_active && window_active=1
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$window_active" = "1" ] || continue
  for prot in ${GRIND_PROTECTED_BRANCHES-dev main master}; do
    if [ "$remote_ref" = "refs/heads/$prot" ]; then
      if [ "${GRIND_ALLOW_PUSH:-0}" = "1" ]; then
        echo "landable-guard: GRIND_ALLOW_PUSH=1 set — allowing push to ${remote_ref} (policy says PRs only; you are overriding)." >&2
      else
        echo "!!! GRIND LANDABLE-GUARD: refusing direct push to ${remote_ref} during an active grind window — open a PR instead. Override: GRIND_ALLOW_PUSH=1 !!!" >&2
        fail=1
      fi
    fi
  done
done

# 3. an unresolvable campaign, and duplicate gate ids
#    Two campaigns that cannot see each other both compute max+1 over the same ledger and
#    both mint the same number. Their rows then land in different sections and merge
#    CLEANLY — measured 2026-08-17, two G-13s in one repository with nothing going red. A
#    duplicate id is only cheap to fix before it is cited; afterwards renumbering reverts
#    silently across commit messages, code comments and reports.
if [ "${GRIND_CAMPAIGN_AMBIGUOUS:-0}" = "1" ]; then
  echo "!!! GRIND LANDABLE-GUARD: cannot tell which campaign this worktree belongs to !!!" >&2
  echo "  Several campaigns exist under .claude/grind/campaigns/ and nothing here names one." >&2
  echo "  Refusing rather than picking one: guessing which campaign's law applies is how an" >&2
  echo "  out-of-focus commit passed clean inside a builder worktree once already." >&2
  echo "  Fix: write the campaign name into <worktree>/.claude/grind-campaign, or export" >&2
  echo "  GRIND_CAMPAIGN=<name> for this shell." >&2
  fail=1
fi
if [ -f "$HERE/gate-id" ]; then
  if ! bash "$HERE/gate-id" check >/dev/null 2>&1; then
    bash "$HERE/gate-id" check >&2 || true
    fail=1
  fi
fi

[ "$fail" = "0" ] || { command -v grind_audit >/dev/null 2>&1 && grind_audit "landable_guard" "BLOCKED push"; exit 1; }
exit 0
